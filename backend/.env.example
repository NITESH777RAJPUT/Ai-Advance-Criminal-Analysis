# ===================================================
# AI-Powered Criminal Network Analysis System
# Backend Environment Configuration Template
# ===================================================

# Databases (Use MongoDB Atlas and Neo4j AuraDB for cloud hosting)
MONGODB_URI=mongodb://localhost:27017/criminal_intelligence
MONGODB_DB_NAME=criminal_intelligence
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Cloudinary Image Storage (Optional - falls back to local disk if unconfigured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authentication & Security (REQUIRED: generate a unique strong secret for production)
JWT_SECRET_KEY=crimenetwork_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
# Add your deployed Vercel frontend URL here, e.g. https://crimenet.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://your-crimenet-app.vercel.app

# Environment
ENVIRONMENT=production
DEBUG=False
